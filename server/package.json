  "description": "Express API server for coLearn-AI",
  "main": "index.js",
  "scripts": {
    "lint:syntax": "node scripts/check-syntax.js",
    "test:unit": "node --test $(ls tests/*.test.js | grep -v '[.]db[.]test[.]js$')",
    "test:db": "node --test --test-concurrency=1 tests/*.db.test.js",
    "test": "npm run lint:syntax && npm run test:unit && npm run test:db",
