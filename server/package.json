    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "googleapis": "^148.0.0",
    "jsdom": "^26.1.0",
    "mariadb": "^3.4.2",
    "mysql2": "^3.14.1",
    "nodemailer": "^7.0.4",
    "openai": "^4.103.0",
